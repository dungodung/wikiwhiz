# Copy to .env for local development. Never commit the real .env file.

FLASK_ENV=development
SECRET_KEY=change-me-dev-only

# --- Database (local docker-compose mariadb, or ToolsDB in production) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wikiwhiz
DB_USER=wikiwhiz
DB_PASSWORD=wikiwhiz

# --- Wikimedia OAuth 2.0 (register at https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose) ---
WIKIWHIZ_OAUTH_CLIENT_ID=
WIKIWHIZ_OAUTH_CLIENT_SECRET=
WIKIWHIZ_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/callback

# --- Wikimedia API access (mandatory descriptive User-Agent, see wikimedia-api-access skill) ---
WIKIWHIZ_USER_AGENT=WikiWhiz/0.1 (https://wikiwhiz.toolforge.org; maintainer contact via meta.wikimedia.org) requests

# --- Degrees-of-Wikipedia live BFS fallback bounds ---
DEGREES_LIVE_BFS_TIMEOUT_SEC=4
DEGREES_LIVE_BFS_NODE_CAP=2000
DEGREES_LIVE_BFS_DEPTH_CAP=6

# --- Low-content-pool maintainer alert ---
LOW_POOL_THRESHOLD=3
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_DEBUG_LOG_ONLY=1
MAIL_FROM=wikiwhiz@toolforge.org
MAINTAINER_EMAIL=
